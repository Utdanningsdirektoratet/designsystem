# Copy to `.env.local` (ignored by git) to run the app with login against the private storage.
# Leave VITE_AUTH_CLIENT_ID commented out to read the local files in `public/illustrations-assets/`
# instead (run `build:assets` first). Restart `dev` after changing this file.
# These values are bundled into the app, so they are not secrets. Put FIGMA_TOKEN in the
# workspace-root `.env.local`, not here.

# Entra ID app registration (single-page app). `http://localhost:4400/illustrasjoner/` must be a
# registered redirect URI.
# VITE_AUTH_CLIENT_ID=
VITE_AUTH_TENANT_ID=

# Address of the private artwork container. Your account needs a role assignment on it. Both of these
# work from localhost: the container through Front Door, or straight from storage.
VITE_ASSET_BASE_URL=https://design.udir.no/illustrasjoner-filer
# VITE_ASSET_BASE_URL=https://stdsillustrations.blob.core.windows.net/illustrations

# Artwork folder in the container, `<hash>-r<revision>`. `pnpm exec tsx scripts/version.ts` prints the
# hash; the revision is the number in `source/artwork-revision.txt`.
VITE_ASSET_VERSION=
