{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {},
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node", "vitest", "@udir-design/theme"]
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
