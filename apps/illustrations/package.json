{
  "name": "@udir-design/apps-illustrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:assets": "node --env-file-if-exists=../../.env.local --import=tsx scripts/fetch.ts && tsx scripts/build.ts",
    "fetch:svgs": "node --env-file-if-exists=../../.env.local --import=tsx scripts/fetch.ts",
    "sync:figma": "node --env-file-if-exists=../../.env.local --import=tsx scripts/sync.ts",
    "typecheck": "tsc",
    "lint": "oxlint",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@azure/msal-browser": "catalog:",
    "@udir-design/icons": "workspace:*",
    "@udir-design/react": "workspace:*",
    "@udir-design/theme": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "proper-lockfile": "catalog:",
    "sharp": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependenciesMeta": {
    "@udir-design/icons": {
      "injected": true
    },
    "@udir-design/react": {
      "injected": true
    }
  }
}
