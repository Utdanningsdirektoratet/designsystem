{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "esnext",
    "module": "esnext",
    "lib": ["es2023", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@udir-design/react": ["./@udir-design/react/src/stable.ts"],
      "@udir-design/theme": ["./@udir-design/theme/src/index.ts"],
      // The built declarations, not generated-src: type-checking the ~960 generated
      // components would add about 1 GB and 2 s to every project that imports icons
      "@udir-design/icons": ["./@udir-design/icons/dist/index.d.mts"],
      "@udir-design/icons/metadata": ["./@udir-design/icons/src/metadata.ts"],
      "@udir-design/symbols": ["./@udir-design/symbols/generated-src/index.ts"],
      "@udir-design/symbols/metadata": [
        "./@udir-design/symbols/generated-src/metadata.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
