{
  "format_on_save": "on",
  "prettier": {
    "allowed": false
  },
  "formatter": {
    "language_server": {
      "name": "oxfmt"
    }
  },
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      },
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      },
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    }
  },
  "lsp": {
    "typescript-ls": {
      "settings": {
        "package_version": "7.0.2"
      }
    }
  },
  // workaround for https://github.com/zed-industries/zed/issues/63693
  // which causes significant lag in Git features and general UI slowness
  "file_scan_exclusions": ["**/node_modules", "..."]
}
