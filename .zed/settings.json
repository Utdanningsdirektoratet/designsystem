{
  "format_on_save": "on",
  "prettier": {
    "allowed": false
  },
  "formatter": {
    "language_server": {
      "name": "oxfmt"
    }
  },
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    }
  }
}
