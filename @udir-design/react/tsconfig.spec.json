{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["vitest/importMeta", "vite/client", "node", "vitest"],
    "paths": {
      "src/*": ["./src/*"],
      "@udir-design/theme": ["../theme/src/index.ts"],
      "@udir-design/icons": ["../icons/dist/index.d.mts"],
      "@udir-design/icons/metadata": ["../icons/src/metadata.ts"],
      "@udir-design/symbols": ["../symbols/generated-src/index.ts"],
      "@udir-design/symbols/metadata": ["../symbols/generated-src/metadata.ts"]
    }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts"
  ]
}
