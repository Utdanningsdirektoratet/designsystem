exports[`Annet-alternativ med avkrysningsbokser 1`] = `
<div data-size="auto">
  <form>
    <style>
      .bs-grid {
  display: grid;
  gap: var(--ds-size-6);
}
    </style>
    <fieldset aria-labelledby="<generated> <generated>">
      <legend id="<generated>">
        Hvilken tilrettelegging trenger eleven på eksamen?
      </legend>
      <p id="<generated>">
        Velg alle som passer.
      </p>
      <ds-field data-clickdelegatefor="<generated>">
        <input
          type="checkbox"
          value="extended-time"
          name="accommodations"
          id="<generated>"
        >
        <label
          data-weight="regular"
          for="<generated>"
        >
          Utvidet tid
        </label>
      </ds-field>
      <ds-field data-clickdelegatefor="<generated>">
        <input
          type="checkbox"
          value="read-aloud"
          name="accommodations"
          id="<generated>"
        >
        <label
          data-weight="regular"
          for="<generated>"
        >
          Opplesing av oppgavene
        </label>
      </ds-field>
      <ds-field data-clickdelegatefor="<generated>">
        <input
          type="checkbox"
          value="spell-checker"
          name="accommodations"
          id="<generated>"
        >
        <label
          data-weight="regular"
          for="<generated>"
        >
          Skrive på datamaskin med retteprogram
        </label>
      </ds-field>
      <ds-field data-clickdelegatefor="<generated>">
        <input
          type="checkbox"
          value="other"
          name="accommodations"
          id="<generated>"
        >
        <label
          data-weight="regular"
          for="<generated>"
        >
          Annet
        </label>
      </ds-field>
      <p
        data-field="validation"
        hidden
        id="<generated>"
      >
      </p>
    </fieldset>
    <button type="submit">
      Gå videre
    </button>
  </form>
</div>
`;

