          </h2>
          <ds-field>
            <label for="exam-subject">
              Fag
            </label>
            <div>
              <input
                id="exam-subject"
                size="20"
                type="text"
                value
              >
            </div>
          </ds-field>
          <ds-field>
            <label for="candidate-number">
              Kandidatnummer
            </label>
            <div
              data-field="description"
              id="<generated>"
            >
              Du finner kandidatnummeret på eksamensbekreftelsen.
            </div>
            <div>
              <input
                id="candidate-number"
                size="12"
                type="text"
                value
                aria-describedby="<generated>"
              >
            </div>
          </ds-field>
          <div>
            <button
              data-variant="secondary"
              type="button"
            >
              Forrige
            </button>
            <button type="submit">
              Neste
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
`;
