exports[`Nytt spørsmål under gruppen 1`] = `
<div data-size="auto">
  <form>
    <style>
      .bs-grid {
  display: grid;
  gap: var(--ds-size-6);
}
    </style>
    <fieldset aria-labelledby="<generated>">
      <legend id="<generated>">
        Har skolen fått tilskudd fra Utdanningsdirektoratet tidligere?
      </legend>
      <ds-field data-clickdelegatefor="<generated>">
        <input
          type="radio"
          value="yes"
          name="previous-grant"
          id="<generated>"
        >
        <label
          data-weight="regular"
          for="<generated>"
        >
          Ja
        </label>
      </ds-field>
      <ds-field data-clickdelegatefor="<generated>">
        <input
          type="radio"
          value="no"
          name="previous-grant"
          id="<generated>"
        >
        <label
          data-weight="regular"
          for="<generated>"
        >
          Nei
        </label>
      </ds-field>
      <p
        data-field="validation"
        hidden
        id="<generated>"
      >
      </p>
    </fieldset>
    <button type="submit">
      Gå videre
    </button>
  </form>
</div>
`;

exports[`Svar i tekstfelt 1`] = `
<div data-size="auto">
  <form>
    <style>
      .bs-grid {
  display: grid;
  gap: var(--ds-size-6);
}

.bs-field {
  display: grid;
  gap: var(--ds-size-2);
}
    </style>
    <div>
      <ds-field>
        <label for="school-org-number">
          Organisasjonsnummeret til skolen
        </label>
        <div
          data-field="description"
          id="<generated>"
        >
          Du finner organisasjonsnummeret i Nasjonalt skoleregister.
        </div>
        <div>
          <input
            id="school-org-number"
            inputmode="numeric"
            autocomplete="off"
            size="12"
            type="text"
            value="987654321"
            aria-describedby="<generated>"
          >
        </div>
      </ds-field>
      <div
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        Skole:
        <strong>
          Eksempel skole, Eksempel kommune
        </strong>
      </div>
    </div>
    <button type="submit">
      Gå videre
    </button>
  </form>
</div>
`;

exports[`Svar som stopper brukeren 1`] = `
<div data-size="auto">
  <form>
    <style>
      .bs-stop {
  display: grid;
}

.bs-stop-alert,
.bs-stop-button {
  margin-block-start: var(--ds-size-6);
}
    </style>
    <fieldset aria-labelledby="<generated>">
      <legend id="<generated>">
        Er skolen godkjent etter privatskoleloven?
      </legend>
      <ds-field data-clickdelegatefor="<generated>">
        <input
          type="radio"
          value="yes"
          name="approved-school"
          id="<generated>"
        >
        <label
          data-weight="regular"
          for="<generated>"
        >
          Ja
        </label>
      </ds-field>
      <ds-field data-clickdelegatefor="<generated>">
        <input
          type="radio"
          value="no"
          name="approved-school"
          id="<generated>"
        >
        <label
          data-weight="regular"
          for="<generated>"
        >
          Nei
        </label>
      </ds-field>
      <p
        data-field="validation"
        hidden
        id="<generated>"
      >
      </p>
    </fieldset>
    <div
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
    </div>
    <button type="submit">
      Gå videre
    </button>
  </form>
</div>
`;

