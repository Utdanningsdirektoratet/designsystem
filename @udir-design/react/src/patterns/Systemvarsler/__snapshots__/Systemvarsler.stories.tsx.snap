    padding: var(--ds-size-4);
  }
}

@media (min-width: 48rem) {
  .systemvarsler-session-expiry {
    padding: var(--ds-size-6);
  }
}

.systemvarsler-session-expiry__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ds-size-3);
}
</style>
<div>
  <dialog
    data-placement="center"
    data-modal="true"
    id="systemvarsler-session-expiry-dialog"
    closedby="none"
    open
  >
    <div>
      <h2>
        Er du her fortsatt?
      </h2>
      <p>
        Du har vært stille en stund. Hvis du ikke gjør noe på denne siden blir du snart logget ut.
      </p>
      <p>
        Du blir logget ut om
        <time datetime="PT60S">
          60
        </time>
        sekunder.
      </p>
    </div>
    <div>
      <button type="button">
        Forbli innlogget
      </button>
      <button
        data-variant="secondary"
        type="button"
      >
        Logg ut
      </button>
    </div>
  </dialog>
</div>
`;
