.systemvarsler-technical-error__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ds-size-3);
}
</style>
<div>
  <header style="<removed>">
    <div>
      <a href="/">
        <div style="<removed>">
          <img
            alt="Utdanningsdirektoratet"
            role="img"
            src="/assets/img/udir-main-logo.svg"
          >
          <img
            alt="Utdanningsdirektoratet"
            role="img"
            src="/assets/img/udir-main-logo-dark-mode.svg"
          >
        </div>
      </a>
    </div>
  </header>
  <main>
    <div>
      <h4 data-size="lg">
        Beklager, noe gikk galt
      </h4>
      <p>
        Vi opplever tekniske problemer og jobber med å løse dem. Dette skyldes ikke noe du gjorde.
      </p>
      <p>
        Vent noen minutter og prøv på nytt, eller gå tilbake til forrige side. Du kan
        <a href="https://www.udir.no/kontakt-oss/">
          kontakte brukerstøtte
        </a>
        hvis problemet fortsetter.
      </p>
    </div>
    <div>
      <button type="button">
        Prøv på nytt
      </button>
      <button
        data-variant="secondary"
        type="button"
      >
        Gå tilbake
      </button>
    </div>
  </main>
</div>
`;

exports[`Varsel om utlogging 1`] = `
<style>
  .systemvarsler-session-expiry {
  box-sizing: border-box;
  display: grid;
  place-items: center;
  width: 100%;
  max-width: 48rem;
  min-height: 12rem;
  margin-inline: auto;
  padding: var(--ds-size-3);
  background: var(--ds-color-surface-default);
}

@media (min-width: 25.5rem) {
