{
  "name": "@udir-design/symbols",
  "version": "0.0.0-semantically-released",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:Utdanningsdirektoratet/designsystem",
    "directory": "@udir-design/symbols"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./metadata": {
      "import": {
        "types": "./dist/metadata.d.mts",
        "default": "./dist/metadata.mjs"
      },
      "require": {
        "types": "./dist/metadata.d.cts",
        "default": "./dist/metadata.cjs"
      }
    },
    "./svg/*.svg": "./dist/svg/*.svg",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "svgr symbols --silent --typescript --ext tsx --no-prettier --index-template config/index-template.js --out-dir generated-src && mv generated-src/index.tsx generated-src/index.ts && oxfmt ./generated-src",
    "update:metadata": "node --import tsx config/metadata.ts",
    "copy:svgs": "shx mkdir -p dist/svg && svgo --quiet --config=config/svgo.config.js -f symbols -o dist/svg",
    "prebuild": "shx rm -rf generated-src && shx mkdir -p generated-src && pnpm run update:metadata && pnpm run generate",
    "build": "tsdown",
    "postbuild": "pnpm run copy:svgs",
    "fetch-new:symbols": "node --env-file=../../.env.local --import tsx config/figma/index.ts",
    "generate:pngs": "node --import tsx config/svg-to-png.ts",
    "lint": "oxlint",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@figma/rest-api-spec": "catalog:",
    "@svgr/cli": "catalog:",
    "@svgr/core": "catalog:",
    "@types/ramda": "catalog:",
    "@types/react": "catalog:",
    "js-yaml": "catalog:",
    "oxfmt": "catalog:",
    "ramda": "catalog:",
    "react": "catalog:",
    "sharp": "catalog:",
    "shx": "catalog:",
    "svgo": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "^18.3.7 || ^19.0.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
