{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "Bundler",
    // `React.createElement`, like Aksel, so the icons import only `react`. With
    // `react/jsx-runtime`, the Storybook manager bundled a runtime that didn't match its React.
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "noEmit": true
  },
  "include": ["generated-src/**/*", "src/**/*"],
  "exclude": ["dist", "node_modules"]
}
