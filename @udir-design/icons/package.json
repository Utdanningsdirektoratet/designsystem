{
  "name": "@udir-design/icons",
  "version": "0.0.0-semantically-released",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:Utdanningsdirektoratet/designsystem",
    "directory": "@udir-design/icons"
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./metadata": "./dist/metadata.mjs",
    "./style.css": "./dist/style.css",
    "./svg/*.svg": "./dist/svg/*.svg",
    "./css/*.css": "./dist/css/*.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "rimraf generated-src && svgr node_modules/@navikt/aksel-icons/dist/svg --config-file .svgrrc.ts --silent --typescript --ext tsx --no-prettier --index-template config/index-template.js --out-dir generated-src && mv generated-src/index.tsx generated-src/index.ts && oxfmt ./generated-src",
    "copy-aksel-icons": "svgo --quiet --config svgo.config.aksel.mjs -f ./node_modules/@navikt/aksel-icons/dist/svg -o ./dist/svg",
    "copy-style": "cp src/style.css dist/",
    "compile": "tsdown",
    "build": "pnpm clean && pnpm generate && pnpm compile && pnpm copy-aksel-icons && pnpm copy-style && pnpm generate-css",
    "generate-css": "tsx generate-css.ts",
    "inject": "echo 'Uncached dummy script: trigger pnpm injected-dependency sync for Turbo builds'",
    "clean": "rimraf ./dist && mkdir ./dist",
    "lint": "oxlint"
  },
  "dependencies": {
    "@navikt/aksel-icons": "catalog:"
  },
  "devDependencies": {
    "@babel/types": "catalog:",
    "@svgr/cli": "catalog:",
    "@svgr/core": "catalog:",
    "@types/react": "catalog:",
    "camelcase": "catalog:",
    "oxfmt": "catalog:",
    "react": "catalog:",
    "rimraf": "catalog:",
    "svgo": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "^18.3.7 || ^19.0.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "untrackedDevDependencies": [
    "tsdown",
    "camelcase",
    "rimraf",
    "@babel/types",
    "oxfmt"
  ]
}
